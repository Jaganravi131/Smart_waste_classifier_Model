.venv/
__pycache__/
*.py[cod]

# Local datasets and generated training artifacts
smart_bin/datasets/
smart_bin/runs/**
# ...but the evidence of a run must be publishable: the report cites metrics,
# curves and a confusion matrix, and those cannot live only on one laptop.
!smart_bin/runs/
!smart_bin/runs/**/
!smart_bin/runs/**/summary.json
!smart_bin/runs/**/history.json
!smart_bin/runs/**/metrics_*.json
!smart_bin/runs/**/robustness_*.json
!smart_bin/runs/arch_sweep.json
!smart_bin/runs/architecture_compare.png
!smart_bin/runs/robustness_*.png
!smart_bin/runs/**/training_curves.png
!smart_bin/runs/**/confusion_matrix_*.png

# Model weights: large binaries do not belong in ordinary source control, with
# one exception - the single shipped model of THIS run. Appendix I of the report
# claims "the complete repository, including the trained weights"; keeping the
# one deployable artefact here is what makes that sentence true. Everything else
# (extra runs, experiments) is ignored.
*.pt
*.onnx
*.tflite
!smart_bin/runs/bingenie_mnv3s_128/best.pt
!smart_bin/runs/bingenie_mnv3s_128/*.onnx
!smart_bin/runs/bingenie_mnv3s_128/*.json

# Runtime logs and generated plots
logs/*.csv
*.png
!smart_bin/runs/**/*.png
!docs/**/*.png

# Local secrets and environment files
.env
.env.*
!.env.example
